# Copie para .env e preencha. O .env nunca é versionado.
# O docker-compose.yml traduz estas variáveis para o padrão Seção__Chave do .NET.

# --- PostgreSQL ---
POSTGRES_DB=jobradar
POSTGRES_USER=jobradar
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_HOST_PORT=5434

# --- Painel de rotinas ---
# Acesso em http://servidor:8080/rotinas. Sem senha, somente loopback é permitido.
DASHBOARD_HOST_PORT=8080
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=

# --- Claude Code CLI ---
# Gere com "claude setup-token" numa máquina com navegador (usa a sua assinatura do Claude).
CLAUDE_CODE_OAUTH_TOKEN=
# Opcional: modelo (vazio = padrão da conta), processos simultâneos e timeout por vaga.
CLAUDE_MODEL=
CLAUDE_MAX_CONCURRENCY=2
CLAUDE_TIMEOUT_SECONDS=180

# --- Discord ---
DISCORD_INTERACTIONS_ENABLED=false
DISCORD_GUILD_ID=
DISCORD_ALLOWED_USER_IDS=
DISCORD_BOT_TOKEN=
# Id do canal (Modo desenvolvedor > clique direito no canal > Copiar ID).
DISCORD_CHANNEL_ID=

# --- Caixa de e-mail com os alertas do LinkedIn (IMAP, só leitura) ---
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=adriano.guzzo@gmail.com
# No Gmail, use uma senha de app (exige verificação em duas etapas).
IMAP_PASSWORD=
# Pasta/marcador para onde um filtro move os alertas (ex.: LinkedIn). INBOX também funciona.
IMAP_FOLDER=INBOX
IMAP_LOOKBACK_DAYS=7

# --- Regras ---
MONITORING_COLLECT_CRON=*/15 * * * *
NOTIFICATION_MINIMUM_SCORE=75

# CLI usado na análise: Claude ou Codex (sem chave de API).
ANALYSIS_PROVIDER=Codex
# Codex usa login da conta; no Docker, veja o comando no README.
CODEX_MODEL=
CODEX_MAX_CONCURRENCY=2
CODEX_TIMEOUT_SECONDS=180
