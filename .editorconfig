root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
trim_trailing_whitespace = true

[*.{cs,csproj,props,targets,json}]
indent_size = 4

[*.{csproj,props,targets,json,yml,yaml,slnx}]
indent_size = 2

[*.sh]
end_of_line = lf

[*.cs]
# Namespaces and usings
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# Prefer explicit types except where the type is obvious from the right-hand side
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# Expression-bodied members for trivial bodies only
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion

# Modern language features
csharp_style_prefer_primary_constructors = true:suggestion
csharp_prefer_braces = true:warning
csharp_style_prefer_pattern_matching = true:suggestion

# Naming and readability
dotnet_style_readonly_field = true:warning
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
dotnet_diagnostic.CA1062.severity = none

# Test names follow Should_X_When_Y.
[tests/**/*.cs]
dotnet_diagnostic.CA1707.severity = none

# EF Core writes these files; they are not hand-maintained.
[**/Migrations/*.cs]
generated_code = true
dotnet_diagnostic.IDE0161.severity = none
dotnet_diagnostic.IDE0011.severity = none
dotnet_diagnostic.IDE0300.severity = none

# Windows PowerShell 5.1 lê .ps1 sem BOM como ANSI.
[*.ps1]
charset = utf-8-bom
