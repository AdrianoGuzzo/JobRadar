{
  // Segredos (connection string, tokens, senhas) NUNCA aqui: só por variável de ambiente (.env).
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Hangfire": "Warning",
        "System.Net.Http": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Monitoring": {
    "CollectCron": "*/15 * * * *",
    "AnalyzeCron": "*/2 * * * *",
    "NotifyCron": "* * * * *"
  },
  "Notification": {
    "MinimumScore": 75
  },
  "Analysis": {
    "BatchSize": 20,
    "MaxConcurrency": 2
  },
  "Claude": {
    "ExecutablePath": "claude",
    "TimeoutSeconds": 180,
    "MaxConcurrency": 2
  },
  "Imap": {
    "Port": 993,
    "Security": "SslOnConnect",
    "Folder": "INBOX",
    "LookbackDays": 7,
    "MaxMessagesPerRun": 50
  },
  "Profile": {
    "Path": "config/profile.json"
  }
}
